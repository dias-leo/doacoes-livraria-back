# ============================================
# Livraria Doacoes - Environment Variables
# ============================================
# Copy this file to .env.local for local development
# DO NOT commit .env files to git
# ============================================

# Porta (Render sobrescreve automaticamente com PORT)
PORT=8080

# Banco de dados - Supabase
# Exemplo: jdbc:postgresql://db.your-project.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres

# Credenciais do banco
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# CORS - Origens permitidas (separadas por vírgula, sem espaços)
# Exemplos: https://seu-front.onrender.com,http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# JPA/Hibernate
# ddl-auto: validate, update, create, create-drop
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

